---
import { author } from '../config';
import GitHubIcon from '../components/GitHubIcon.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = author.name, description = author.tagline } = Astro.props;
const githubUrl = `https://github.com/${author.github}`;
const repoUrl = `${githubUrl}/${author.github}.github.io`;
const buildDate = new Date();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand-title" href="/">{author.name}</a>
        <a href={githubUrl} rel="me"><GitHubIcon /> GitHub</a>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container muted">
        <a href={repoUrl}>Source</a> -- built <time datetime={buildDate.toISOString()}>{buildDate.toISOString().slice(0, 10)}</time>{' '}
        with <a href="https://astro.build">Astro</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --fg: #1f2937;
    --muted: #6b7280;
    --border: #e5e7eb;
    --accent: #2563eb;
    --hover-bg: #f9fafb;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f172a;
      --fg: #e5e7eb;
      --muted: #9ca3af;
      --border: #1f2937;
      --accent: #60a5fa;
      --hover-bg: #111827;
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
    font-size: 15px;
    line-height: 1.5;
    background: var(--bg);
    color: var(--fg);
  }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    padding-block: 1.5rem 3rem;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .container {
    width: 100%;
    max-width: 56rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  .muted {
    color: var(--muted);
  }
  .icon {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    fill: currentColor;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    padding-block: 1rem;
  }
  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-header a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .brand-title {
    font-weight: 600;
    color: var(--fg);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 1rem;
    font-size: 0.9rem;
  }
</style>
