---
import type { ResolvedProject } from '../config';
import { formatAbsoluteDate, formatRelativeDate } from '../lib/relative-time';
import GitHubIcon from './GitHubIcon.astro';

interface Props {
  project: ResolvedProject;
  /** Time of the last push, if known. */
  lastTouched?: Date;
  now: Date;
}

const { project, lastTouched, now } = Astro.props;
---

<li class="row">
  <div class="heading">
    <a class="path" href={project.pagesUrl}><code>{project.path}</code></a>
    <a class="title" href={project.pagesUrl}>{project.title}</a>
  </div>
  <p class="description">{project.description}</p>
  <p class="meta">
    <a class="repo" href={project.repoUrl}><GitHubIcon /> GitHub</a>
    <span aria-hidden="true">·</span>
    {
      lastTouched ? (
        <time datetime={lastTouched.toISOString()} title={`Last push: ${formatAbsoluteDate(lastTouched)}`}>
          {formatRelativeDate(lastTouched, now)}
        </time>
      ) : (
        <span title="Last push date could not be fetched from GitHub">unknown</span>
      )
    }
  </p>
</li>

<style>
  .row {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }
  .path {
    color: var(--fg);
    font-weight: 600;
  }
  .title {
    color: var(--muted);
  }
  .description {
    margin: 0.25rem 0;
  }
  .meta {
    margin: 0;
    display: flex;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
</style>
